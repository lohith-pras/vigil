<Window x:Class="Vigil.PanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Vigil"
        Title="Vigil" Width="340" Height="540"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <Window.Resources>
        <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <Style x:Key="Muted" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SubText}" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style x:Key="Value" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="Divider" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="{DynamicResource CardBorder}" />
            <Setter Property="Margin" Value="0,12,0,12" />
        </Style>

        <Style x:Key="Bar" TargetType="ProgressBar">
            <Setter Property="Height" Value="6" />
            <Setter Property="Maximum" Value="100" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="10,0,12,0" />
            <Setter Property="Foreground" Value="{DynamicResource Accent}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border x:Name="PART_Track" CornerRadius="3" Background="{DynamicResource Track}" />
                            <Border x:Name="PART_Indicator" CornerRadius="3" HorizontalAlignment="Left"
                                    Background="{TemplateBinding Foreground}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Tab" TargetType="RadioButton">
            <Setter Property="GroupName" Value="Tabs" />
            <Setter Property="Foreground" Value="{DynamicResource SubText}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="b" CornerRadius="8" Background="Transparent" Height="34" Margin="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.FontFamily="{StaticResource Icons}" TextElement.FontSize="16" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource Hover}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource TabSel}" />
                                <Setter Property="Foreground" Value="{DynamicResource Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Switch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="track" Width="40" Height="22" CornerRadius="11" Background="{DynamicResource Track}">
                            <Ellipse x:Name="thumb" Width="16" Height="16" Margin="3" Fill="White" HorizontalAlignment="Left" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="track" Property="Background" Value="{DynamicResource Accent}" />
                                <Setter TargetName="thumb" Property="HorizontalAlignment" Value="Right" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Chip" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ChipBg}" />
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" CornerRadius="14" Background="{TemplateBinding Background}" Padding="0,7">
                            <ContentPresenter HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Opacity" Value="0.85" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ChipOn" TargetType="Button" BasedOn="{StaticResource Chip}">
            <Setter Property="Background" Value="{DynamicResource Accent}" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <Style x:Key="Link" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Field" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource ChipBg}" />
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
            <Setter Property="CaretBrush" Value="{DynamicResource Text}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6,5" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="Footer" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource Card}" />
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" CornerRadius="8" Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource CardBorder}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource Hover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="14,12,14,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Logo -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
            <TextBlock Text="&#xE7B3;" FontFamily="{StaticResource Icons}" FontSize="18" VerticalAlignment="Center"
                       Foreground="{DynamicResource Accent}" Margin="0,0,8,0" />
            <TextBlock Text="Vigil" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />
        </StackPanel>

        <!-- Tab bar -->
        <Border Grid.Row="1" CornerRadius="12" Background="{DynamicResource Card}" BorderBrush="{DynamicResource CardBorder}"
                BorderThickness="1" Padding="3">
            <UniformGrid Columns="6">
                <RadioButton x:Name="AwakeTab" Style="{StaticResource Tab}" Content="&#xE708;" Tag="Keep awake"
                             ToolTip="Keep awake" AutomationProperties.Name="Keep awake" Checked="Tab_Checked" />
                <RadioButton x:Name="DisplaysTab" Style="{StaticResource Tab}" Content="&#xE7F4;" Tag="Displays"
                             ToolTip="Displays" AutomationProperties.Name="Displays" Checked="Tab_Checked" />
                <RadioButton x:Name="SystemTab" Style="{StaticResource Tab}" Content="&#xE9D9;" Tag="System"
                             ToolTip="System" AutomationProperties.Name="System" Checked="Tab_Checked" />
                <RadioButton x:Name="ProcTab" Style="{StaticResource Tab}" Content="&#xE71D;" Tag="Processes"
                             ToolTip="Processes" AutomationProperties.Name="Processes" Checked="Tab_Checked" />
                <RadioButton x:Name="NetTab" Style="{StaticResource Tab}" Content="&#xE774;" Tag="Network &amp; battery"
                             ToolTip="Network &amp; battery" AutomationProperties.Name="Network and battery" Checked="Tab_Checked" />
                <RadioButton x:Name="DiskTab" Style="{StaticResource Tab}" Content="&#xEDA2;" Tag="Disks"
                             ToolTip="Disks" AutomationProperties.Name="Disks" Checked="Tab_Checked" />
            </UniformGrid>
        </Border>

        <TextBlock x:Name="SectionTitle" Grid.Row="2" Margin="2,14,0,8" FontSize="11" FontWeight="SemiBold"
                   Foreground="{DynamicResource SubText}" />

        <!-- Card holding the selected page -->
        <Border Grid.Row="3" CornerRadius="10" Background="{DynamicResource Card}" BorderBrush="{DynamicResource CardBorder}"
                BorderThickness="1" Padding="14,14,14,6">
            <ScrollViewer VerticalScrollBarVisibility="Hidden" Focusable="False">
            <Grid Margin="0,0,0,8">
                <!-- Keep awake -->
                <StackPanel x:Name="AwakePage" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="AwakeStatus" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <CheckBox x:Name="AwakeSwitch" Grid.Column="1" Style="{StaticResource Switch}"
                                  AutomationProperties.Name="Keep awake" Click="AwakeSwitch_Click" />
                    </Grid>
                    <UniformGrid x:Name="Chips" Columns="4" Margin="-3,12,-3,0">
                        <Button Style="{StaticResource Chip}" Tag="15" Content="15m" Click="Chip_Click" />
                        <Button Style="{StaticResource Chip}" Tag="30" Content="30m" Click="Chip_Click" />
                        <Button Style="{StaticResource Chip}" Tag="60" Content="1h" Click="Chip_Click" />
                        <Button Style="{StaticResource Chip}" Tag="120" Content="2h" Click="Chip_Click" />
                        <Button Style="{StaticResource Chip}" Tag="240" Content="4h" Click="Chip_Click" />
                        <Button Style="{StaticResource Chip}" Tag="480" Content="8h" Click="Chip_Click" />
                        <Button Style="{StaticResource Chip}" Tag="0" Content="∞" Click="Chip_Click" AutomationProperties.Name="Indefinitely" />
                        <Button Style="{StaticResource Chip}" Tag="until" Content="Until…" Click="Chip_Click" />
                    </UniformGrid>
                    <StackPanel x:Name="UntilRow" Orientation="Horizontal" Margin="0,8,0,0" Visibility="Collapsed">
                        <TextBlock Text="Until" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox x:Name="UntilBox" Style="{StaticResource Field}" Width="70"
                                 AutomationProperties.Name="Until time, hours and minutes" />
                        <Button x:Name="UntilStart" Style="{StaticResource Chip}" Content="Start" Padding="14,0"
                                Click="UntilStart_Click" Margin="8,0,0,0" MinWidth="64" />
                        <TextBlock x:Name="UntilError" Foreground="{DynamicResource Danger}" FontSize="12"
                                   VerticalAlignment="Center" Margin="8,0,0,0" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Muted}" Margin="0,10,0,0"
                               Text="Click a chip to start. Click it again to stop." />
                    <Border Style="{StaticResource Divider}" />
                    <Button x:Name="OptionsToggle" Style="{StaticResource Link}" Content="›  Options"
                            HorizontalAlignment="Left" Click="OptionsToggle_Click" />
                    <StackPanel x:Name="OptionsPanel" Visibility="Collapsed" Margin="0,12,0,0">
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="Keep display on" />
                                <TextBlock Style="{StaticResource Muted}" Text="Applied whenever Keep awake is active" TextWrapping="Wrap" />
                            </StackPanel>
                            <CheckBox x:Name="DisplaySwitch" Grid.Column="1" Style="{StaticResource Switch}" Tag="display"
                                      AutomationProperties.Name="Keep display on" Click="Option_Click" />
                        </Grid>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="Only when plugged in" />
                                <TextBlock Style="{StaticResource Muted}" Text="Pauses while on battery" TextWrapping="Wrap" />
                            </StackPanel>
                            <CheckBox x:Name="PluggedSwitch" Grid.Column="1" Style="{StaticResource Switch}" Tag="plugged"
                                      AutomationProperties.Name="Only when plugged in" Click="Option_Click" />
                        </Grid>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="Pause when locked" />
                                <TextBlock Style="{StaticResource Muted}" Text="Pauses while the PC is locked (Win+L)" TextWrapping="Wrap" />
                            </StackPanel>
                            <CheckBox x:Name="LockedSwitch" Grid.Column="1" Style="{StaticResource Switch}" Tag="locked"
                                      AutomationProperties.Name="Pause when locked" Click="Option_Click" />
                        </Grid>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="Turn on when Vigil starts" />
                                <TextBlock Style="{StaticResource Muted}" Text="Starts indefinitely at launch" TextWrapping="Wrap" />
                            </StackPanel>
                            <CheckBox x:Name="StartupSwitch" Grid.Column="1" Style="{StaticResource Switch}" Tag="startup"
                                      AutomationProperties.Name="Turn on when Vigil starts" Click="Option_Click" />
                        </Grid>
                        <TextBlock Text="While these apps are open" />
                        <TextBlock Style="{StaticResource Muted}" Text="Keep awake turns on by itself" />
                        <WrapPanel x:Name="AppList" Margin="-3,6,-3,0" />
                    </StackPanel>
                </StackPanel>

                <local:DisplaysPage x:Name="DisplaysPage" Visibility="Collapsed" />

                <!-- System -->
                <StackPanel x:Name="SystemPage" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource Heading}" Text="Hardware usage" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="CPU" VerticalAlignment="Center" />
                        <ProgressBar x:Name="CpuBar" Grid.Column="1" Style="{StaticResource Bar}" />
                        <TextBlock x:Name="CpuText" Grid.Column="2" Style="{StaticResource Value}" />
                    </Grid>
                    <local:Sparkline x:Name="CpuGraph" Height="50" Margin="0,8,0,0"
                                     Stroke="{DynamicResource Accent}" Guide="{DynamicResource SubText}" />

                    <Border Style="{StaticResource Divider}" />

                    <TextBlock Style="{StaticResource Heading}" Text="Memory" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="RAM" VerticalAlignment="Center" />
                        <ProgressBar x:Name="RamBar" Grid.Column="1" Style="{StaticResource Bar}" />
                        <TextBlock x:Name="RamText" Grid.Column="2" Style="{StaticResource Value}" />
                    </Grid>
                    <local:Sparkline x:Name="RamGraph" Height="50" Margin="0,8,0,0"
                                     Stroke="{DynamicResource Teal}" Guide="{DynamicResource SubText}" />
                </StackPanel>

                <!-- Processes -->
                <StackPanel x:Name="ProcPage" Visibility="Collapsed">
                    <Grid Margin="0,0,0,8">
                        <TextBlock Style="{StaticResource Heading}" Text="Top apps" VerticalAlignment="Center" Margin="0" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="SortCpu" Style="{StaticResource Chip}" Content="CPU" MinWidth="54" Click="Sort_Click"
                                    AutomationProperties.Name="Sort by CPU" />
                            <Button x:Name="SortRam" Style="{StaticResource Chip}" Content="RAM" MinWidth="54" Click="Sort_Click"
                                    AutomationProperties.Name="Sort by memory" />
                        </StackPanel>
                    </Grid>
                    <StackPanel x:Name="ProcList" />
                    <TextBlock x:Name="ProcStatus" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0" />
                </StackPanel>

                <!-- Network & battery -->
                <StackPanel x:Name="NetPage" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource Heading}" Text="Network" />
                    <Grid Margin="0,0,0,4">
                        <TextBlock Text="↓  Download" />
                        <TextBlock x:Name="DownText" Style="{StaticResource Value}" />
                    </Grid>
                    <Grid>
                        <TextBlock Text="↑  Upload" />
                        <TextBlock x:Name="UpText" Style="{StaticResource Value}" />
                    </Grid>
                    <local:Sparkline x:Name="NetGraph" Height="50" Margin="0,8,0,0" Max="0"
                                     Stroke="{DynamicResource Accent}" Guide="{DynamicResource SubText}" />
                    <local:SpeedTestView x:Name="SpeedTestBlock" />

                    <Border Style="{StaticResource Divider}" />

                    <TextBlock Style="{StaticResource Heading}" Text="Battery" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="56" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Charge" VerticalAlignment="Center" />
                        <ProgressBar x:Name="BatBar" Grid.Column="1" Style="{StaticResource Bar}" />
                        <TextBlock x:Name="BatPct" Grid.Column="2" Style="{StaticResource Value}" />
                    </Grid>
                    <Grid Margin="0,10,0,0">
                        <Border x:Name="BatPill" HorizontalAlignment="Left" CornerRadius="10" Padding="8,2,10,3">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="BatDot" Width="7" Height="7" VerticalAlignment="Center" Margin="0,1,6,0" />
                                <TextBlock x:Name="BatState" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="BatTime" Style="{StaticResource Muted}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock x:Name="BatHealth" Style="{StaticResource Muted}" Margin="0,8,0,0" Visibility="Collapsed" />

                    <Border Style="{StaticResource Divider}" />

                    <TextBlock Style="{StaticResource Heading}" Text="Bluetooth devices" />
                    <StackPanel x:Name="DeviceList" />

                    <Border Style="{StaticResource Divider}" />
                    <local:AlertsView x:Name="AlertsBlock" />
                </StackPanel>

                <!-- Disks -->
                <StackPanel x:Name="DiskPage" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource Heading}" Text="Drives" />
                    <StackPanel x:Name="DiskList" />
                </StackPanel>
            </Grid>
            </ScrollViewer>
        </Border>

        <!-- Footer -->
        <UniformGrid Grid.Row="4" Columns="2" Margin="0,12,0,0">
            <Button x:Name="SettingsButton" Style="{StaticResource Footer}" Margin="0,0,6,0" Click="Settings_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE713;" FontFamily="{StaticResource Icons}" VerticalAlignment="Center" Margin="0,1,8,0" />
                    <TextBlock Text="Settings" FontWeight="SemiBold" />
                </StackPanel>
            </Button>
            <Button Style="{StaticResource Footer}" Margin="6,0,0,0" Click="Quit_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE7E8;" FontFamily="{StaticResource Icons}" VerticalAlignment="Center" Margin="0,1,8,0" />
                    <TextBlock Text="Quit" FontWeight="SemiBold" />
                </StackPanel>
            </Button>
        </UniformGrid>
    </Grid>
</Window>
