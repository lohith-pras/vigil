<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- NotifyIcon (tray) lives in WinForms; WPF has no tray API. -->
    <UseWindowsForms>true</UseWindowsForms>
    <!-- WPF + WinForms implicit usings clash (Application, MessageBox, ...). -->
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- ponytail: placeholder eye icon (exe / Explorer). Swap the file for a real one later. -->
    <ApplicationIcon>Vigil.ico</ApplicationIcon>
    <!-- WFO0003 wants WinForms' SetHighDpiMode, but WPF owns this process: the manifest is the right place. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <Version>0.2.0</Version>
    <Product>Vigil</Product>
  </PropertyGroup>

  <ItemGroup>
    <!-- Displays tab: laptop panel brightness (WMI root\WMI). Loaded only when that tab opens. -->
    <PackageReference Include="System.Management" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Also drawn as the tray icon. -->
    <EmbeddedResource Include="Vigil.ico" LogicalName="Vigil.ico" />
    <!-- Geist + Geist Mono (SIL OFL, see Fonts/OFL.txt), used by the panel via pack://application:,,,/Fonts/ -->
    <Resource Include="Fonts\*.ttf" />
  </ItemGroup>

</Project>
