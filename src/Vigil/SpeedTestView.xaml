<!-- "Run speed test" block for the Network section. Uses the panel's styles and brushes. -->
<UserControl x:Class="Vigil.SpeedTestView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="0,10,0,0">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button x:Name="RunButton" Style="{DynamicResource Chip}" Content="Run speed test" Padding="14,0"
                    MinWidth="120" Margin="-3,0,8,0" Click="Run_Click" />
            <TextBlock x:Name="Status" Grid.Column="1" Style="{DynamicResource Muted}" VerticalAlignment="Center"
                       TextWrapping="Wrap" />
        </Grid>
        <UniformGrid x:Name="Results" Columns="3" Margin="0,10,0,0" Visibility="Collapsed">
            <StackPanel>
                <TextBlock x:Name="DownValue" FontSize="16" FontWeight="SemiBold" Text="—" />
                <TextBlock Style="{DynamicResource Muted}" Text="↓ Mbps" />
            </StackPanel>
            <StackPanel>
                <TextBlock x:Name="UpValue" FontSize="16" FontWeight="SemiBold" Text="—" />
                <TextBlock Style="{DynamicResource Muted}" Text="↑ Mbps" />
            </StackPanel>
            <StackPanel>
                <TextBlock x:Name="PingValue" FontSize="16" FontWeight="SemiBold" Text="—" />
                <TextBlock Style="{DynamicResource Muted}" Text="Ping ms" />
            </StackPanel>
        </UniformGrid>
    </StackPanel>
</UserControl>
